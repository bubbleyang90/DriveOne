# Only edit this LOCAL file after copying it to .env. Never commit .env.
# No provider is connected until you register your own application and approve OAuth.
PORT=4318
# Defaults to ./downloads. Absolute local paths are supported.
# DRIVEONE_DOWNLOAD_DIR=C:\Users\YourName\Downloads\DriveOne
# Metadata and tokens stay in RAM; all accounts disconnect when the process stops.
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_TENANT=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# Optional safety limit per download, in bytes (default 20 GiB):
# DRIVEONE_MAX_DOWNLOAD_BYTES=21474836480
